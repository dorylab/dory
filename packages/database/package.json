{
    "name": "@dory/database",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./schema": "./src/schema.ts",
        "./provider": "./src/provider.ts",
        "./i18n": "./src/i18n.ts",
        "./types": "./src/types/index.ts",
        "./utils": "./src/utils.ts",
        "./postgres/client": "./src/postgres/client/index.ts",
        "./postgres/client/pg": "./src/postgres/client/pg.ts",
        "./postgres/client/pglite": "./src/postgres/client/pglite.ts",
        "./postgres/schemas": "./src/postgres/schemas/index.ts",
        "./postgres/schemas/*": "./src/postgres/schemas/*.ts",
        "./postgres/impl/*": "./src/postgres/impl/*/index.ts",
        "./postgres/migrate": "./src/postgres/migrate.ts",
        "./pglite/*": "./src/pglite/*.ts",
        "./postgres/impl/knowledge/organization": "./src/postgres/impl/knowledge/organization.ts",
        "./postgres/impl/knowledge/extraction": "./src/postgres/impl/knowledge/extraction.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@dory/artifacts": "0.1.0",
        "@dory/data-plane": "0.1.0",
        "@dory/resultset": "0.1.0",
        "@dory/schema-compare": "0.1.0",
        "@dory/shared": "0.1.0",
        "@electric-sql/pglite": "^0.4.3",
        "ajv": "^8.18.0",
        "drizzle-orm": "^0.45.2",
        "pg": "^8.20.0",
        "yaml": "^2.8.2"
    },
    "devDependencies": {
        "@types/node": "^25.5.2",
        "@types/pg": "^8.20.0",
        "typescript": "^6.0.2"
    }
}
