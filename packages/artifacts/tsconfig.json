{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "types": ["node"],
        "paths": {
            "@dory/resultset": ["../resultset/src/index.ts"],
            "@dory/resultset/*": ["../resultset/src/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
