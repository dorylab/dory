      {
        "sql": "WITH monthly AS (SELECT strftime('%Y-%m', created_at) AS month, COUNT(*) AS order_count FROM orders GROUP BY strftime('%Y-%m', created_at)), ranked AS (SELECT month, order_count, ROW_NUMBER() OVER (ORDER BY month DESC) AS rn FROM monthly) SELECT m1.month AS current_month, m1.order_count AS current_count, m2.month AS prev_month, m2.order_count AS prev_count, ROUND((m1.order_count - m2.order_count) * 100.0 / m2.order_count, 2) AS mom_change_pct FROM ranked m1 JOIN ranked m2 ON m1.rn = 1 AND m2.rn = 2",
        "rows": [
          {
            "prev_count": "54",
            "prev_month": "2026-02",
            "current_count": "65",
            "current_month": "2026-03",
            "mom_change_pct": "20.37"
          }
        ],
        "runId": "chat_9fb2a3cefddcdf93f565e614bbc68dcf",
        "title": "Orders — month, order count",
