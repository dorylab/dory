# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
playwright-report/
playwright/.auth/
test-results/
blob-report/

# next.js
.next/
.next-*/
.next-docs/
next-env.d.ts

# build and packaging outputs (all workspaces)
out/
dist/
dist-scripts/
dist-electron/
release/
build/
.output/

# temporary files and generated task artifacts (all workspaces)
.tmp/
.tmp-*/
tmp/
tmp-*/
.temp/
.temp-*/
temp/
temp-*/
output/
*.tmp
*.temp
*.bak
*.swp
*.swo

# tool caches
.cache/
.turbo/
.parcel-cache/
.pnpm-store/
.eslintcache
.prettiercache
__pycache__/
*.py[cod]

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.log.*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# pglite
localdata/
scan-symbol.cjs

apps/web/data/

# Native DuckDB extensions are provisioned for the build platform, never committed.
/apps/web/public/resources/duckdb/
