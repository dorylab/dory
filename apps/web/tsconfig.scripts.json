{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "ES2017",
        "module": "ESNext",
        "esModuleInterop": true,
        "isolatedModules": false,
        "allowImportingTsExtensions": true
    },
    "include": ["global.d.ts", "scripts/**/*.ts", "scripts/**/*.mts"],
    "exclude": ["node_modules"]
}
