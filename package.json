{
  "name": "dory",
  "version": "0.3.10",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dorylab/dory.git"
  },
  "scripts": {
    "dev": "bun run --filter v4 dev",
    "prebuild": "bun run --filter v4 prebuild",
    "build": "bun run --filter v4 build",
    "build:bootstrap": "bun run --filter v4 build:bootstrap",
    "deploy": "bun run --filter v4 deploy",
    "start": "bun run --filter v4 start",
    "studio": "bun run --filter v4 studio",
    "pglite:studio": "bun run --filter v4 pglite:studio",
    "drizzle:push": "bun run --filter v4 drizzle:push",
    "migrate:generate": "bun run --filter v4 migrate:generate",
    "pglite:migrate:generate": "bun run --filter v4 pglite:migrate:generate",
    "pglite:migrate:compile": "bun run --filter v4 pglite:migrate:compile",
    "pglite:seed:queries": "bun run --filter v4 pglite:seed:queries",
    "client:migrate:generate": "bun run --filter v4 client:migrate:generate",
    "client:migrate:compile": "bun run --filter v4 client:migrate:compile",
    "lint": "bun run --filter v4 lint",
    "lint:fix": "bun run --filter v4 lint:fix",
    "typecheck": "bun run --filter v4 typecheck",
    "format:write": "bun run --filter v4 format:write",
    "format:check": "bun run --filter v4 format:check",
    "test:clean-json": "bun run --filter v4 test:clean-json",
    "docker:build": "docker build --build-arg VERSION=$(git rev-parse HEAD) -t dorylab/dory .",
    "docker:run": "bun run --filter v4 docker:run",
    "registry:build": "bun run --filter v4 registry:build",
    "electron:compile": "bun run --filter dory compile",
    "electron:dev": "bun run --filter dory dev",
    "electron:dev:app": "bun run --filter dory dev:app",
    "electron:standalone": "bun run --filter dory electron:standalone",
    "electron:build": "bun run --filter dory build",
    "electron:build:apple": "bun run electron:standalone && bun run --filter dory electron:build:apple",
    "electron:build:win": "bun run electron:standalone && bun run --filter dory electron:build:windows",
    "admin:dev": "bun run --filter admin dev",
    "admin:build": "bun run --filter admin build",
    "admin:start": "bun run --filter admin start",
    "admin:lint": "bun run --filter admin lint",
    "admin:typecheck": "bun run --filter admin typecheck",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:docker": "PLAYWRIGHT_INCLUDE_DOCKER=1 playwright test --grep @docker",
    "release-notes": "bun run --filter v4 release-notes"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.54.2"
  }
}
